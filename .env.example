# Embedding / Vector DB
EMBEDDING_PROVIDER=sentence-transformers

# Default Hugging Face model name.
# You can also replace this with a local model directory path, for example:
# EMBEDDING_MODEL=/absolute/path/to/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

CHROMA_PERSIST_DIR=./chroma_db

# LiteLLM
# When these values are configured, rag_query.py will automatically try LLM answer generation.
# If LiteLLM is unavailable or the request fails, the program falls back to extractive answers.
LITELLM_API_KEY=your_api_key_here
LITELLM_BASE_URL=https://your-litellm-endpoint/
LITELLM_MODEL=gemini-2.5-flash
